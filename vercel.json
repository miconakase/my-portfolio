{
  "installCommand": "npm install",
  "buildCommand": "vite build && node scripts/finish-build.mjs",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude)admin'",
  "rewrites": [{ "source": "/", "destination": "/api/page" }],
  "headers": [{ "source": "/app.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }]
}
